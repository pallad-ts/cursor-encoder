{
  "name": "@pallad/cursor-encoder",
  "version": "2.0.0",
  "description": "Pagination cursor encoding and decoding",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "yarn@4.11.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "yarn run -TB vitest run --passWithNoTests",
    "lint": "yarn run -TB eslint src/**/*.ts",
    "build:clean": "yarn run -TB tsc --build --clean tsconfig.build.json",
    "entrysmith": "yarn run generate-barrels && yarn run -TB entrysmith fix",
    "prepare": "yarn run entrysmith",
    "prepublish": "yarn run compile",
    "compile": "yarn run entrysmith && yarn run build:clean && yarn run -TB tsc --build tsconfig.build.json",
    "generate-barrels": "yarn run -TB barrelsby -l replace -L --delete -d ./src"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pallad-ts/cursor-encoder.git",
    "directory": "package/main"
  },
  "author": "Łukasz Kużyński <lukasz.kuzynski@gmail.com> (http://wookieb.pl)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pallad-ts/cursor-encoder/issues"
  },
  "homepage": "https://github.com/pallad-ts/cursor-encoder#readme",
  "peerDependencies": {
    "tslib": "^2"
  },
  "devDependencies": {
    "@pallad/errors-dev": "^1.1.0",
    "@pallad/id": "^1.1.0",
    "@types/sinon": "^21",
    "sinon": "^21.1.2"
  },
  "dependencies": {
    "@pallad/errors": "^1.0.1",
    "alpha-serializer": "^0.5.6"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}